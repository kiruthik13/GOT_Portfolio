# ══════════════════════════════════════════
# GOT Portfolio — Environment Variables
# ══════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── GitHub Integration ──────────────────
# Your GitHub username (used by GithubStats component)
VITE_GITHUB_USERNAME=your_github_username

# ── EmailJS Contact Form ─────────────────
# Sign up at https://www.emailjs.com/
# Dashboard → Email Services → Add New Service → get Service ID
VITE_EMAILJS_SERVICE_ID=your_service_id

# Dashboard → Email Templates → Create Template → get Template ID
VITE_EMAILJS_TEMPLATE_ID=your_template_id

# Dashboard → Account → Public Key
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# ── Backend API (optional) ──────────────
# Only needed if running the backend/server.js locally
VITE_API_URL=http://localhost:5000
